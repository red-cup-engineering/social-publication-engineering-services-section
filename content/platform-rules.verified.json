      "x-evidence": {
        "record": "platform-terms-x",
        "observedOn": "2026-10-24",
        "fields": {
          "text.maxGraphemes": "unverified",
          "automation.mode": "verified",
          "aiDisclosure": "verified",
          "limits.perAccount": "own-policy",
          "windows": "own-policy",
          "duplicates": "own-policy",
          "cadence": "own-policy",
          "hashtags.max": "own-policy"
        },
        "notes": "Mode is manual-only because of cost, not because the platform bars automation. Reach of link posts versus link-free posts: X's product head and owner said in July 2026 that no link penalty has applied for over a year (reported by PPC Land and Free Press Journal, secondary sources, not read on X itself); the open-sourced ranking code shows no explicit URL rule (the same secondary report); marketing blogs claiming a 50 to 90 percent penalty are unsourced. Treated as unverified: the plan does not depend on links either way.",
        "supplementary": "platform-terms-x-link-and-cost-2026-10-25"
      }
