        "note": "The \"bot\" self-label is offered, not required; house policy sets it on every automated account and says so in the bio."
      },
      "aiDisclosure": {
        "required": true,
        "offered": false,
        "mechanism": "text-label",
        "apiField": null,
        "textLabel": "AI-generated media"
      },
      "limits": {
        "perAccount": {
          "perHour": 1,
          "perDay": 4,
          "minGapMinutes": 180
        }
      },
      "windows": [
        {
          "days": [
            1,
            2,
            3,
            4,
            5
          ],
          "startHour": 8,
          "endHour": 20
        }
      ],
      "duplicates": {
        "blockSameTextWithinDays": 30
      },
      "linkBack": "required",
      "cadence": {
        "targetPerDay": 2
      },
      "x-evidence": {
        "record": "platform-terms-bluesky",
        "observedOn": "2026-10-24",
        "fields": {
          "text.maxGraphemes": "unverified",
          "automation.mode": "verified",
          "aiDisclosure": "not-stated",
          "limits.perAccount": "own-policy",
          "windows": "own-policy",
          "duplicates": "own-policy",
          "cadence": "own-policy",
          "hashtags.max": "own-policy"
        },
        "notes": "Platform write limit is 5,000 points/hour and 35,000/day (a create costs 3); our caps are far lower by choice. Post length 300 graphemes is enforced by the engine adapter; the platform page for it could not be fetched. The platform has no AI-content rule; the label is house policy."
      }
